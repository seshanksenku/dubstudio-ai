FROM nvidia/cuda:11.8.0-cudnn8-devel-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 HF_HOME=/cache/huggingface
RUN apt-get update && apt-get install -y --no-install-recommends python3.10 python3.10-venv python3-pip git ffmpeg libgl1 libglib2.0-0 build-essential && rm -rf /var/lib/apt/lists/*
RUN python3.10 -m venv /opt/muse && python3.10 -m venv /opt/studio
RUN git clone https://github.com/TMElyralab/MuseTalk.git /opt/MuseTalk && cd /opt/MuseTalk && git checkout 0a89dec45a0192b824e3cf4daf96c239440c5ed8
RUN /opt/muse/bin/pip install torch==2.0.1 torchvision==0.15.2 torchaudio==2.0.2 --index-url https://download.pytorch.org/whl/cu118
RUN /opt/muse/bin/pip install -r /opt/MuseTalk/requirements.txt && /opt/muse/bin/pip install openmim==0.3.9
RUN /opt/muse/bin/mim install mmengine==0.10.7 && /opt/muse/bin/mim install mmcv==2.0.1 && /opt/muse/bin/mim install mmdet==3.1.0 && /opt/muse/bin/mim install mmpose==1.1.0
WORKDIR /app
COPY requirements.txt .
RUN /opt/studio/bin/pip install torch==2.2.2 --index-url https://download.pytorch.org/whl/cpu && /opt/studio/bin/pip install -r requirements.txt
COPY app app
COPY scripts scripts
ENV PATH=/opt/studio/bin:$PATH MUSETALK_DIR=/opt/MuseTalk MUSETALK_PYTHON=/opt/muse/bin/python
CMD ["python", "-m", "app.worker"]
